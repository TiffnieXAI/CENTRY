# Centry backend configuration - TEMPLATE.
#
#   cp .env.example .env      # then edit .env with real values
#
# .env is gitignored (see .gitignore) - NEVER put real credentials in this
# file or commit a filled-in .env. Every value below is a placeholder.
#
# All keys are read by app/config.py with the CENTRY_ prefix (pydantic
# settings). Anything you don't override falls back to the safe default in
# config.py.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Fast local dev without MySQL: set this true and skip the MySQL block.
CENTRY_USE_SQLITE=false

# Real (MySQL) credentials. Used only when CENTRY_USE_SQLITE=false.
CENTRY_DB_USERNAME=root
CENTRY_DB_PASSWORD=change-me
CENTRY_DB_HOST=localhost
CENTRY_DB_PORT=3306
CENTRY_DB_NAME=centry_db

# ---------------------------------------------------------------------------
# Auth (JWT)
# ---------------------------------------------------------------------------
# ⚠️ CHANGE THIS before deploying anywhere real - generate with:
#   openssl rand -hex 32
# The default in config.py is an obvious placeholder; a known secret means
# anyone can forge a valid token.
CENTRY_JWT_SECRET_KEY=change-me-run-openssl-rand-hex-32
CENTRY_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# OAuth - platform app credentials (only needed to actually connect shops)
# ---------------------------------------------------------------------------
# Your backend's public base URL. Must exactly match the redirect URI
# registered in each platform's developer/partner console.
CENTRY_OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Shopee Open Platform (open.shopee.com)
CENTRY_SHOPEE_PARTNER_ID=
CENTRY_SHOPEE_PARTNER_KEY=

# Lazada Open Platform (open.lazada.com)
CENTRY_LAZADA_APP_KEY=
CENTRY_LAZADA_APP_SECRET=

# TikTok Shop Partner Center (partner.tiktokshop.com) - endpoints unverified,
# see app/core/oauth/tiktok_shop.py
CENTRY_TIKTOK_SHOP_APP_KEY=
CENTRY_TIKTOK_SHOP_APP_SECRET=
CENTRY_TIKTOK_SHOP_SERVICE_ID=

# Meta for Developers (developers.facebook.com)
CENTRY_META_APP_ID=
CENTRY_META_APP_SECRET=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# JSON array of origins allowed to call the API from a different origin.
# Not needed when the backend serves the pages itself (same-origin).
# CENTRY_CORS_ALLOWED_ORIGINS='["http://localhost:5173"]'

# ---------------------------------------------------------------------------
# RabbitMQ (powers /ws/events)
# ---------------------------------------------------------------------------
# The default below is RabbitMQ's own guest/guest localhost default - fine
# for local dev, change for any shared/deployed instance.
CENTRY_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Keep the API up (with a logged warning) if RabbitMQ isn't running. Set false
# once the broker is a hard dependency in an environment.
CENTRY_RABBITMQ_OPTIONAL=true
